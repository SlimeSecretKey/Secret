local AccountPermKeyID = 1234567890

local PermKeyButtonAccount = Instance.new("TextButton")
PermKeyButtonAccount.Name = "PermKeyButtonAccount"
PermKeyButtonAccount.Parent = Main
PermKeyButtonAccount.BackgroundColor3 = Color3.new(1, 0, 1)
PermKeyButtonAccount.Size = UDim2.new(0.8, 0, 0.1, 0)
PermKeyButtonAccount.Position = UDim2.new(0.1, 0, 0.8, 0)
PermKeyButtonAccount.TextColor3 = Color3.new(1, 1, 1)
PermKeyButtonAccount.TextScaled = true
PermKeyButtonAccount.Font = Enum.Font.FredokaOne
PermKeyButtonAccount.TextXAlignment = Enum.TextXAlignment.Center
PermKeyButtonAccount.TextYAlignment = Enum.TextYAlignment.Center
PermKeyButtonAccount.Visible = true

if MarketplaceService:UserOwnsGamePassAsync(Player.UserId, AccountPermKeyID) then
    PermKeyButtonAccount.Text = "Use Account Perm Key"
    PermKeyButtonAccount.BackgroundColor3 = Color3.new(0, 1, 0)
else
    PermKeyButtonAccount.Text = "Buy Account Perm Key (800 Robux)"
end


PermKeyButtonAccount.Activated:Connect(function()
    if MarketplaceService:UserOwnsGamePassAsync(Player.UserId, AccountPermKeyID) then
        loadstring(game:HttpGet("https://raw.githubusercontent.com/Slime0077/Script/refs/heads/main/SDhub"))()
    else
        MarketplaceService:PromptPurchase(Player, AccountPermKeyID)
    end
end)


